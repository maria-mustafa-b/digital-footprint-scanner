import asyncio
import re

async def run_sherlock(username: str) -> list[dict]:
    """
    Runs Sherlock as a subprocess and parses the results.
    Returns a list of found profiles.
    """
    process = await asyncio.create_subprocess_exec(
        "sherlock", username,
        "--print-found",        # only print hits, not misses
        "--no-color",           # clean output for parsing
        "--timeout", "10",      # don't hang on slow sites
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
    )

    stdout, stderr = await process.communicate()
    output = stdout.decode("utf-8", errors="ignore")

    results = []
    for line in output.splitlines():
        # Sherlock output format: [+] Platform: https://url.com/username
        match = re.match(r"\[\+\]\s+(.+?):\s+(https?://\S+)", line)
        if match:
            results.append({
                "platform": match.group(1).strip(),
                "url": match.group(2).strip(),
                "status": "found",
            })

    return results
